# Sharpnr Docs (Next.js / fumadocs) -- install to /etc/systemd/system/
#
# REPLACES the pre-monorepo unit, which ran `npm start` from an rsynced copy at
# /media/sharpnrllpDrive/frontends/sharpnr-docs and built on the server. The
# bundle is now Next's "standalone" output, built by Jenkins and copied to
# /var/www/docs -- no npm, no pnpm, no build on optimus.
#
#   sudo systemctl cat sharpnr-docs > ~/sharpnr-docs.service.bak
#   sudo cp deploy/docs/sharpnr-docs.service /etc/systemd/system/
#   sudo systemctl daemon-reload

[Unit]
Description=Sharpnr Docs (Next.js)
After=network.target

[Service]
Type=simple
User=sharpnrllp
Group=webdeploy

# server.js sits at <root>/apps/docs/ because Next mirrors the workspace
# layout inside the standalone bundle.
WorkingDirectory=/var/www/docs/apps/docs

# There is no system node on this host -- node is nvm-managed under
# /home/sharpnrllp. That is also why ProtectHome must NOT be set: it would hide
# /home and the binary with it. Update this path when the nvm version changes,
# or install a system node and point here instead.
ExecStart=/home/sharpnrllp/.nvm/versions/node/v22.22.3/bin/node server.js
Environment=PATH=/home/sharpnrllp/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/bin

Environment=NODE_ENV=production
# Matches proxy_pass in sites-available/sharpnr-docs-app. Under standalone the
# package.json `start` script is unused, so this is the only thing setting it.
Environment=PORT=6956
# Bind loopback only; without this Next listens on 0.0.0.0 and the app is
# reachable directly on :6956 from the LAN, bypassing nginx.
Environment=HOSTNAME=127.0.0.1

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
