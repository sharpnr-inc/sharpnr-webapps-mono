{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // 1 -- fully serialized. Turbo sizes concurrency off CPU count, but the
  // binding constraint is memory, and the CI host is the tightest target by a
  // wide margin: 3.6 GB total, ~950 MB available at rest, already swapping,
  // while also running postgres, redis, nginx and the engines. One orchestrator
  // build alone peaks at ~2.3 GB, so anything above 1 risks the OOM killer
  // choosing a production service instead of the build.
  // Override locally for faster dev builds: TURBO_CONCURRENCY=4 pnpm build
  //
  // NOTE: this applies to `dev` too, where turbo requires concurrency to exceed
  // the number of persistent tasks -- so the root `dev` script passes
  // --concurrency=16 explicitly. Without it, even `turbo dev --filter <one-app>`
  // refuses to start.
  "concurrency": "1",
  "globalDependencies": [".env.production", ".env.development"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
