# systemd unit for the Sharpnr website SSR server (Arch Linux host).
#
# One-time setup on the server:
#   1. sudo cp deploy/sharpnr-website.service /etc/systemd/system/
#   2. Adjust User= below — it must be able to read /var/www/website/.output
#   3. sudo systemctl daemon-reload && sudo systemctl enable sharpnr-website
#   4. Let Jenkins do the rest — its deploy stage runs:
#        sudo systemctl restart sharpnr-website
#      which requires this sudoers rule (sudo visudo -f /etc/sudoers.d/jenkins-sharpnr):
#        jenkins ALL=(root) NOPASSWD: /usr/bin/systemctl restart sharpnr-website
#      (replace "jenkins" with the user your Jenkins agent runs as)
#
# The Nitro node-server build is self-contained — no node_modules on the
# server, just node itself (pacman -S nodejs, any current LTS).

[Unit]
Description=Sharpnr website SSR server
After=network.target

[Service]
Type=simple
# User that runs the Node process — adjust to your setup
User=jenkins
WorkingDirectory=/var/www/website
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /var/www/website/.output/server/index.mjs
Restart=on-failure
RestartSec=3

# Hardening — the process only needs to read its own files and bind one port
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/www/website

[Install]
WantedBy=multi-user.target
