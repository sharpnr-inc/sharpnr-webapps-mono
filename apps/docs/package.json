{
  "name": "sharpnr-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 6954",
    "start": "next start --port 6954",
    "build": "next build",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "gsap": "catalog:",
    "lottie-react": "^2.4.1",
    "lucide-react": "catalog:",
    "mermaid": "^11.15.0",
    "next": "16.2.6",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "deploy": {
    "dir": "docs",
    "runtime": "node",
    "service": "sharpnr-docs",
    "note": "Next.js (fumadocs) standalone -- needs a live node process (/api/search, OG images, llms.txt), so it is never a static dist copy. The pipeline copies the standalone bundle to /var/www/docs and restarts the sharpnr-docs unit (see deploy/docs/). nginx proxies docs.sharpnr.com -> 127.0.0.1:6956; the unit sets PORT, and the package.json `start` script is unused in production."
  }
}
