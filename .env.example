# The single env template for every app in the monorepo. Apps do not carry
# their own .env.example -- each app's vite.config.ts sets `envDir` to the repo
# root, so this one file is what they all read.
#
# Copy to .env.development (dev server) or .env.production (build), then adjust
# the hosts. Both are gitignored. CI injects .env.production from a Jenkins
# credential instead.
#
# Most apps validate these at startup in src/configs/env.ts and THROW on a
# missing one, so a var absent here becomes a runtime crash, not a warning.

## Sharpnr-Engine BaseUrl
VITE_API_URL=https://api.sharpnr.test/api/v1

## CSRF Cookie Name
VITE_API_CSRF=_dev_csrf


## All Sharpnr Platform Services URL (dev)
VITE_API_ACCOUNTING_APP=https://accounting.sharpnr.test
VITE_API_ORCHESTRATOR_APP=https://orchestrator.sharpnr.test
VITE_API_SHARPCRM_APP=https://sharpcrm.sharpnr.test
VITE_API_HR_APP=https://hr.sharpnr.test
VITE_API_SILO_APP=https://silo.sharpnr.test
VITE_API_CORTEX_APP=https://cortex.sharpnr.test
VITE_API_FOLIO_APP=https://folio.sharpnr.test
VITE_API_STOCKWAVE_APP=https://stockwave.sharpnr.test
VITE_API_SHARP_MARKETPLACE_APP=https://marketplace.sharpnr.test
VITE_API_CABLES_APP=https://cables.sharpnr.test

## Other Sharpnr Platform App Links
VITE_API_AUTH_APP=https://auth.sharpnr.test
VITE_API_IAM_APP=https://iam.sharpnr.test

## Sharpnr Business Operation Apps
VITE_API_HOSPITALITY_APP=https://hospitality.sharpnr.test
VITE_API_HEALTHCARE_APP=https://healthcare.sharpnr.test

## Sharpnr's Guide and Documentation
VITE_API_SHARPNRS_GUIDE_DOCS_APP=https://docs.sharpnr.test

## sharpnr's Website
## The website app no longer lives in this monorepo, but this URL is still a
## REQUIRED var: orchestrator and sharp-hospitality read it (orchestrator throws
## on startup if it is missing). Point it at wherever the site is deployed.
VITE_WEBSITE_APP=https://sharpnr.test